# Pinned upstream revisions. realmctl and CI read this file; the Dockerfiles take
# them as build-args. Bump deliberately and rebuild the images.
MANGOS_CLASSIC_COMMIT=de8f72993b9e1faa1bf92dd5505f3daec5cea3ce
CLASSIC_DB_COMMIT=4d230bb1bd477948cac61c107d2718b3ea04a5b8
# github.com/cmangos/playerbots, dropped into src/modules/PlayerBots; moves with the core pin.
PLAYERBOTS_COMMIT=31e0f32b543fee46941db51225bb7b432eace236
WENILLA_REPO=https://github.com/AceyKubbo/wenilla-web
# A full commit hash, never a branch name — branch names are not reproducible builds.
# FORK: this pins AceyKubbo/wenilla-web's `main` (8f6eeb95 = upstream 0.3.1 sync plus the
# glue-VM `_G` compatibility fix, 4839497f), so the realm image built from this fork serves a
# client that loads post-1.12 realm-list UIs. Upstream's bump-realm-pin bot does not target
# this fork, so the pin is maintained by hand here: bump it to a real commit of WENILLA_REPO
# and rebuild. Upstream's flow and history are in docs/RELEASE.md.
WENILLA_COMMIT=8f6eeb951d4e8bc326445f1e7fe64bbf3c6ed19d
