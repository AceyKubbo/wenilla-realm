# 本地试用（macOS + localhost）模板。正式部署到 VM 时请用 `./realmctl init` 重新生成，
# 不要直接拿这个文件去公网用：域名、Data 路径、密码都必须换成你自己的。
#
# 用法：cp .env.local-trial.example .env && 编辑其中三项密码（openssl rand -hex 24）。
# 真实密码已写在当前 .env（mode 600，不进版本库）。

# localhost = Caddy 内部 CA，浏览器会告警一次。公网必须换成真实域名（80/443 开放、A 记录已生效）。
REALM_DOMAIN=localhost

# 你自己的 1.12.1 (build 5875) 客户端 Data/ 目录的绝对路径。
# 本机已确认：/Users/kubbo.ai/games/twmoa_1181_cn/twmoa_1181/Data
CLIENT_DATA=/path/to/your/1.12.1/Data

# 用 openssl rand -hex 24 生成，三个都要不同。
DB_ROOT_PASSWORD=replace-me
DB_MANGOS_PASSWORD=replace-me
DB_REALMWEB_PASSWORD=replace-me

MANGOS_TAG=latest
REALM_TAG=latest

# 必须为 1：mangosd 没有 mmaps 不会启动（SETUP.md §4）。
EXTRACT_MMAPS=1

# 世界服务器内存上限。Mac 上按需调；每个随机 NPC +~20 MB。
MANGOSD_MEM=3g
